datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String   @id @default(cuid())
  fullName           String
  username           String   @unique
  email              String   @unique
  passwordHash       String
  avatarUrl          String?
  bio                String?
  role               String   @default("USER") // ADMIN, USER, MODERATOR, PREMIUM_USER
  isVerified         Boolean  @default(false)
  twoFactorEnabled   Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  portfolios         Portfolio[]
  transactions       Transaction[]
  sessions           Session[]
  refreshTokens      RefreshToken[]
}

model Portfolio {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  theme         String   @default("glassmorphism") // glassmorphism, neo-brutalism, minimalist, dark-cyber
  slug          String   @unique
  isPublic      Boolean  @default(true)
  views         Int      @default(0)
  likes         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects      Project[]
  skills        Skill[]
  experiences   Experience[]
  socialLinks   SocialLink[]
  analytics     Analytics[]
}

model Project {
  id           String    @id @default(cuid())
  portfolioId  String
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  techStack    String    // Comma-separated list e.g. "React,TypeScript,Tailwind"
  githubUrl    String?
  liveUrl      String?
  imageUrl     String?
  featured     Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

model Transaction {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Float
  type       String   // INCOME, EXPENSE
  category   String   // SaaS, Freelance, Hardware, Marketing, Other
  notes      String?
  createdAt  DateTime @default(now())
}

model Analytics {
  id             String    @id @default(cuid())
  portfolioId    String
  portfolio      Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  visitors       Int       @default(0)
  clicks         Int       @default(0)
  impressions    Int       @default(0)
  engagementRate Float     @default(0.0)
  recordedDate   DateTime  @default(now())
}

model Skill {
  id           String    @id @default(cuid())
  portfolioId  String
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  name         String
  level        Int       @default(80) // 0-100 rating
}

model Experience {
  id           String    @id @default(cuid())
  portfolioId  String
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  company      String
  role         String
  startDate    String
  endDate      String?
  description  String?
}

model SocialLink {
  id           String    @id @default(cuid())
  portfolioId  String
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  platform     String    // GitHub, LinkedIn, Twitter, YouTube, Website
  url          String
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
}
